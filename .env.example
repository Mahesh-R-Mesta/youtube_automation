# ──────────────────────────────────────────────────────────────
# YouTube Automation Pipeline — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Google Gemini (LLM) ───────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# ── ElevenLabs TTS (optional — edge-tts is the free primary) ──
# Free tier: 10,000 credits/month. https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Default voice ID (Rachel - natural female). Find IDs at elevenlabs.io/voice-lab
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Pexels (stock images) ─────────────────────────────────────
# Free API key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ── Trend Discovery ─────────────────────────────────────────────────────
# RSS feeds (BBC, Reuters, NPR, Al Jazeera, AP, Google News) are always enabled.
# The two keys below are OPTIONAL but add more sources and better coverage.

# The Guardian (5 000 req/day free, no delay)
# Free key at: https://bopenplatform.theguardian.com/access/
GUARDIAN_API_KEY=your_guardian_api_key_here

# NewsData.io (200 credits/day free, real-time)
# Free key at: https://newsdata.io/register
NEWSDATA_API_KEY=your_newsdata_api_key_here

# ── YouTube (upload) ──────────────────────────────────────────
# 1. Create project at: https://console.cloud.google.com/
# 2. Enable "YouTube Data API v3"
# 3. Create OAuth 2.0 credentials (Desktop app) and download as client_secrets.json
YOUTUBE_CREDENTIALS_FILE=client_secrets.json
# public | unlisted | private
YOUTUBE_PRIVACY=public
# 25 = News & Politics
YOUTUBE_CATEGORY_ID=25

# ── TTS Settings ──────────────────────────────────────────────
# Run: python -c "import asyncio, edge_tts; asyncio.run(edge_tts.list_voices())" to list voices
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+5%

# ── Video Settings ────────────────────────────────────────────
VIDEO_FPS=24
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

# ── Scheduler ─────────────────────────────────────────────────
# Run pipeline daily at HH:MM (24-hour format)
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# ── Output ────────────────────────────────────────────────────
OUTPUT_DIR=output
